# /etc/systemd/system/ccrc-hub.service — Hub server (chạy trên máy chủ nội bộ/VPS)
# Sửa WorkingDirectory, User và CCRC_TOKEN trước khi bật.
[Unit]
Description=CC Remote Control Hub
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ccrc
WorkingDirectory=/opt/cc-remote-control
Environment=CCRC_PORT=8720
Environment=CCRC_TOKEN=thay-token-cua-ban-vao-day
# Liên hệ gắn vào Web Push. Đường systemd KHÔNG đọc file .env, nên đây là chỗ
# duy nhất đặt được. Apple từ chối mọi push gửi dưới một liên hệ không định vị
# được (403 BadJwtToken) — để nguyên giá trị mẫu bên dưới là iPhone không nhận
# được thông báo nào, trong khi /notify vẫn trả về thành công và thiết bị vẫn
# hiện là đã đăng ký. Android (FCM) và Firefox không bị ảnh hưởng.
Environment=CCRC_VAPID_SUBJECT=https://thay-domain-hub-cua-ban
ExecStart=/usr/bin/node server/src/index.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
