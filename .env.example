# Sao chép thành .env rồi sửa: cp .env.example .env

# BẮT BUỘC — token của admin. Sinh bằng: openssl rand -hex 24
CCRC_TOKEN=

# Cổng hub trên máy host (mặc định 8720)
#CCRC_PORT=8720

# Địa chỉ bind cổng trên host. Đặt 127.0.0.1 khi đã có tunnel/reverse proxy
# đứng trước (hub không lộ ra LAN). Mặc định 0.0.0.0.
#CCRC_BIND=127.0.0.1

# Lịch sử thông báo chỉ nằm trong RAM và mất khi hub khởi động lại — đúng
# thiết kế, không có tuỳ chọn lưu ra đĩa.

# Địa chỉ liên hệ gắn vào Web Push
#CCRC_VAPID_SUBJECT=mailto:admin@congty.vn

# --- Chỉ dùng với profile cloudflare (home server sau NAT, khuyến nghị) ----
# Token của tunnel tạo trong Cloudflare Zero Trust -> Networks -> Tunnels.
# Đây là BÍ MẬT — ai có token là chạy được tunnel dưới domain của bạn.
#CCRC_TUNNEL_TOKEN=

# --- Chỉ dùng với profile tls (docker compose --profile tls up -d) ----------
# Domain đã trỏ DNS về máy này; Caddy tự lấy chứng chỉ Let's Encrypt
#CCRC_DOMAIN=ccrc.example.com
